# All current/future data and local execution evidence are excluded.
/data/**
/artifacts/**
/docs/**
# Explicit document exceptions are appended from the reviewed allowlist.

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/
build/
dist/
.tmp/
tmp/
*.tmp
*.log
*.junit.xml
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.credentials*
secrets.*
*_secret.*
.idea/
.vscode/
.ipynb_checkpoints/
Thumbs.db
Desktop.ini
.DS_Store
# Prevent accidental staging of price files and generated binary outputs anywhere.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.npz
*.npy
*.zip
*.gz

